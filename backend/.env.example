PORT=3001
JWT_SECRET=replace_me
# Production on Railway: use private DATABASE_URL (auto-injected on the API service).
# Local dev / npm run snapshot:today: paste DATABASE_PUBLIC_URL here as DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/dbname
# If Railway auto-injects private URL above, add the public URL here (script + server auto-switch):
# DATABASE_PUBLIC_URL=postgres://user:password@roundhouse.proxy.rlwy.net:PORT/railway
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-...
ENABLE_JOBS=true
ADMIN_SECRET=replace_me
